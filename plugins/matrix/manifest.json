{
  "id": "matrix",
  "name": "Matrix",
  "version": "1.0.0",
  "network_type": "matrix",
  "author": "OSIRIS Team",
  "description": "Matrix federatif mesajlaşma odalarından veri toplama",
  "config_schema": {
