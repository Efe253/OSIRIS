# OSIRIS API — uygulama imajı
# Kullanım: docker compose --profile api up -d --build
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Önce SDK ve dahili modüller (katman önbelleği için)
COPY osiris-sdk ./osiris-sdk
COPY osiris-collector ./osiris-collector
COPY osiris-graph ./osiris-graph
COPY osiris-query ./osiris-query
COPY osiris-alert ./osiris-alert
COPY osiris-report ./osiris-report
COPY osiris-api ./osiris-api
COPY plugins ./plugins

RUN pip install --no-cache-dir \
    ./osiris-sdk \
    ./osiris-collector \
    ./osiris-graph \
    ./osiris-query \
    ./osiris-alert \
    ./osiris-report \
    ./osiris-api \
 && for req in plugins/*/requirements.txt; do \
        pip install --no-cache-dir -r "$req"; \
    done

EXPOSE 8000

# nobody kullanıcısının yazabileceği rapor dizini (ReportGenerator varsayılanı)
RUN mkdir -p /app/reports && chown nobody:nogroup /app/reports

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

USER nobody

CMD ["osiris-api"]
